# Salin ke .env lalu isi. JANGAN commit .env ke git.
# Pilih salah satu cara login: token, ATAU identifier + password.

# --- cara 1: email/username + password ---
SIBLE_IDENTIFIER=
SIBLE_PASSWORD=

# --- cara 2: bearer token (diisi otomatis oleh `login --token` / refresh) ---
SIBLE_TOKEN=
SIBLE_REFRESH_TOKEN=

# --- opsional ---
SIBLE_API_BASE=https://prod.sible.network/api/v1
SIBLE_SLOT_HOURS=3
SIBLE_AUTO_ADS=1

# --- pengaman (opsional, default sudah aman) ---
SIBLE_MIN_GAP_MS=4000        # jeda minimal antar request tulis
SIBLE_JITTER_PCT=25          # acak +/- persen dari jeda
SIBLE_MAX_RETRIES=4          # retry saat 429/5xx/network error
SIBLE_BACKOFF_MS=5000        # basis backoff (dikali 2 tiap percobaan)
SIBLE_TIMEOUT_MS=20000
SIBLE_DAILY_AD_CAP=30        # batas accelerate per hari
SIBLE_DAILY_CLAIM_CAP=10     # batas claim per hari
SIBLE_DAILY_START_CAP=10     # batas start slot per hari
SIBLE_USER_AGENT=            # kosongkan untuk default
SIBLE_ACCEPT_LANGUAGE=en-US,en;q=0.9
