# Salin ke .env lalu isi. JANGAN commit .env ke git.
# Pilih salah satu cara login: token, ATAU identifier + password.

# --- cara 1: email/username + password ---
SIBLE_IDENTIFIER=
SIBLE_PASSWORD=

# --- cara 2: bearer token (diisi otomatis oleh `login --token` / refresh) ---
SIBLE_TOKEN=
SIBLE_REFRESH_TOKEN=

# --- opsional ---
SIBLE_API_BASE=https://prod.sible.network/api/v1
SIBLE_SLOT_HOURS=3
SIBLE_AUTO_ADS=1
